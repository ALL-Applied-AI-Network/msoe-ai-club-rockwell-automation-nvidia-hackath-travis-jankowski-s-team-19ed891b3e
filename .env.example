# Copy to .env and fill in. Never commit .env.

# build.nvidia.com key (https://build.nvidia.com/settings/api-keys), used by the VLM (in-context) detector
NVIDIA_BUILD_API_KEY=

# Any OpenAI-compatible chat endpoint with image input. Defaults shown.
# Self-hosted Cosmos 3 (vLLM on Brev/Spark): VLM_BASE_URL=http://<host>:8000/v1  VLM_MODEL=nvidia/Cosmos3-Nano
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=google/gemma-4-31b-it
# Box order the model answers in: yxyx for Gemma/Gemini, xyxy for Cosmos/Qwen (default picks by model name)
# VLM_BOX_ORDER=yxyx
